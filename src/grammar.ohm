Klog {
  file = blankLine* records? newline? blankLine* blankCharacter* end
  records = record (newline blankLine+ record)*
  blankLine = blankCharacter* newline

  record = recordHead (newline recordSummary)? (newline recordEntries)?
  recordHead = date (" "+ shouldTotal)? " "* &eol
  shouldTotal = "(" duration "!)"

  // The first entry establishes one indentation unit for this record.
  // Try longer units first so four spaces are not mistaken for two levels.
  recordEntries = entries<"    "> | entries<"   "> | entries<"  "> | entries<"\t">
  entries<i> = indentedEntry<i> (newline indentedEntry<i>)*
  entry = indentedEntry<"    "> | indentedEntry<"   "> | indentedEntry<"  "> | indentedEntry<"\t">
  indentedEntry<i> = i (duration | timeRange) entrySummary<i>?

  recordSummary = recordSummaryLine (newline recordSummaryLine)*
  recordSummaryLine = summaryChar lineText
  summaryChar = ~(blankCharacter | newline) any
  lineText = (~newline any)*

  entrySummary<i> = " " lineText continuation<i>* -- same
                  | continuation<i>+ -- next
  continuation<i> = newline i i nonblankText
  nonblankText = ~(blankCharacter* eol) lineText

  date = digit digit digit digit "-" digit digit "-" digit digit
       | digit digit digit digit "/" digit digit "/" digit digit

  duration = ("-" | "+")? digit+ "h" ("0".."5" digit | digit &"") "m" -- hourMinute
           | ("-" | "+")? digit+ "h" -- hour
           | ("-" | "+")? digit+ "m" -- minute

  timeRange = shiftedTime " "* "-" " "* "?"+ -- open
            | shiftedTime " "* "-" " "* shiftedTime -- closed

  shiftedTime = backwardsShiftedTime | forwardsShiftedTime | time
  backwardsShiftedTime = "<" time
  forwardsShiftedTime = time ">"

  time = twentyFourHour ":" "0".."5" digit ~period -- twentyFourHour
       | ("1" "0".."2" | "0"? digit) ":" "0".."5" digit period? -- twelveHour

  twentyFourHour = "2" "0".."4" -- a
                 | "0".."1" digit -- b
                 | digit -- c

  period = "am" | "pm"
  eol = newline | end
  newline = "\n" | "\r\n"

  // Characters as defined in the Unicode "Space Separator" category, and tab.
  blankCharacter = "\t"
                 | " "
                 | "\u00A0"
                 | "\u1680"
                 | "\u2000"
                 | "\u2001"
                 | "\u2002"
                 | "\u2003"
                 | "\u2004"
                 | "\u2005"
                 | "\u2006"
                 | "\u2007"
                 | "\u2008"
                 | "\u2009"
                 | "\u200A"
                 | "\u202F"
                 | "\u205F"
                 | "\u3000"
}
